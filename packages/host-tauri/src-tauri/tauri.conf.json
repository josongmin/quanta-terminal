{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quanta Terminal",
  "version": "0.1.0",
  "identifier": "app.quanta.terminal",
  "build": {
    "beforeDevCommand": "pnpm --filter @quanta/host-tauri dev:vite",
    "beforeBuildCommand": "pnpm --filter @quanta/host-tauri dev:vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quanta Terminal",
        "width": 1200,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "resources": [
      "../resources/shell-integration/bash.sh",
      "../resources/shell-integration/zsh.zsh",
      "../resources/shell-integration/fish.fish"
    ]
  }
}
